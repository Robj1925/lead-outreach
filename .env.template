# Name signed on every outreach message. Required for a live send (--send).
# The --sender "Name" flag overrides this.
SENDER_NAME=Your Name

# Path to the leads CSV. The --leads <file> flag overrides this.
# Defaults to ./leads.csv relative to the working directory.
#LEADS_CSV=./leads.csv

# Business-hours window on a 24-hour clock. The --hours 9-18 flag overrides these.
#BUSINESS_HOURS_START=9
#BUSINESS_HOURS_END=18

# API keys for phone number carrier validation
# (Optional: the tool will automatically fallback to local offline NANPA database checks if keys are missing or exhausted)
NUMVERIFY_API_KEY=your_numverify_api_key_here
ABSTRACT_API_KEY=your_abstract_api_key_here
